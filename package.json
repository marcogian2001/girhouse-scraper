{
  "name": "next-js-boilerplate",
  "author": "Ixartz (https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl -i \"CampaignStatus.status_*\" \"ContactStatus.status_*\" \"CampaignSettingsForm.processor_*\" \"ColumnMapper.field_*\" \"EnrichmentCard.confidence_*\" \"EnrichmentCard.field_*\" \"KnowledgeManager.kind_*\" \"LeadSearchStatus.status_*\" \"LeadStatus.status_*\" \"LeadSearchForm.website_*\" \"LeadTable.source_*\" \"LeadTable.filter_*\"",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server -m 100 --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server -m 100 --run 'npm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@arcjet/next": "1.13.0",
    "@hookform/resolvers": "5.9.1",
    "@logtape/logtape": "2.3.7",
    "@sentry/nextjs": "10.75.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "geist": "1.7.2",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-intl": "4.14.6",
    "next-themes": "0.4.6",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/prompt-cli": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@electric-sql/pglite-socket": "0.2.11",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.63.0",
    "@spotlightjs/spotlight": "4.11.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.8",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
